<!DOCTYPE html>
<html>

<head>
  <title>Sign Up - rifftales</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dx8d5hlk1/image/upload/v1757542335/favicon-120x120_jprwqx.png" />
  <link rel="preconnect" href="https://res.cloudinary.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="<%- !process.env.BACKEND_URL.includes('localhost') ? process.env.BACKEND_URL : '' %>/js/parallax-bg.js"></script>
  <link rel="stylesheet" href="<%- !process.env.BACKEND_URL.includes('localhost') ? process.env.BACKEND_URL : '' %>/css/styles.css">
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font-family: "Roboto Slab", serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #122634;
      color: #d1d5db;
      display: flex;
      flex-direction: column;
    }

    .main-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 6vh;
    }

    @media (max-width: 768px) {
      .main-content {
        padding-top: 0;
      }
    }

    .login-container {
      background: #122634;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 450px;
      margin: 1rem;
    }

    h1 {
      color: #ffffff;
      font-size: 1.5rem;
      font-weight: 600;
      text-align: center;
      margin: 0 0 0.5rem 0;
    }

    h2 {
      color: #ffffff;
      font-size: 1.125rem;
      font-weight: 500;
      text-align: center;
      margin: 0 0 0.5rem 0;
    }

    p {
      color: #9ca3af;
      text-align: center;
      margin: 0 0 1.5rem 0;
      font-size: 0.875rem;
    }

    .form-errors {
      background: rgba(220, 38, 38, 0.3);
      border: 1px solid #dc2626;
      border-radius: 6px;
      padding: 0.75rem;
      margin-bottom: 1rem;
    }

    .form-errors ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .form-errors li {
      color: #fca5a5;
      font-size: 0.875rem;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    label {
      display: block;
      color: #d1d5db;
      font-size: 0.875rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    input[type="text"],
    input[type="email"],
    textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid #4b5563;
      border-radius: 6px;
      background: #ffffff;
      color: #000000;
      font-size: 0.875rem;
      transition: all 0.2s ease;
    }

    input[type="text"]::placeholder,
    input[type="email"]::placeholder,
    textarea::placeholder {
      color: #9ca3af;
    }

    input[type="text"]:focus,
    input[type="email"]:focus,
    textarea:focus {
      outline: none;
      border-color: #60a5fa;
      box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
    }

    textarea {
      resize: vertical;
      min-height: 80px;
    }

    .input-error {
      border-color: #dc2626 !important;
      box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1) !important;
    }

    button {
      width: 100%;
      background: #2563eb;
      color: #ffffff;
      border: none;
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    button:hover:not(:disabled) {
      background: #1d4ed8;
    }

    button:disabled {
      background: #4b5563;
      cursor: not-allowed;
    }

    .register-link {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.875rem;
    }

    .register-link a {
      color: #3b82f6;
      text-decoration: none;
      font-weight: 500;
    }

    .register-link a {
      color: #60a5fa;
    }

    .register-link a:hover {
      color: #93c5fd;
      text-decoration: underline;
    }

    .logo-container {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 2rem;
      font-weight: bold;
    }

    .logo-image {
      width: 32px;
      height: 32px;
      margin-right: 0.5rem;
    }

    .logo-text {
      color: #EAAA00;
      font-size: 1.75rem;
      font-weight: bold;
      line-height: 1;
    }

    .guest-login-form {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #e5e7eb;
      text-align: center;
    }

    .guest-login-description {
      margin-bottom: 0.75rem;
    }

    .guest-login-button {
      width: 100%;
      background: #1d52bc;
      color: #ffffff;
      border: none;
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .guest-login-button:hover {
      background: #1543a5;
    }

    .guest-login-form {
      border-top: 1px solid #4b5563;
    }
  </style>
</head>

<body>
  <div class="main-content">
    <div class="login-container">
      <div style="position: relative;">
        <a href="<%= process.env.FRONTEND_URL || 'http://localhost:5173' %>" 
           style="position: absolute; top: -20px; left: -20px; color: #60a5fa; text-decoration: none; font-size: 0.875rem; font-weight: 500;">
          ‹ Return to app
        </a>
        <div class="logo-container">
          <img src="https://res.cloudinary.com/dx8d5hlk1/image/upload/v1757542336/favicon-192x192_kkkkll.png"
            alt="rifftales Logo" class="logo-image" />
          <span class="logo-text">rifftales</span>
        </div>
      </div>

      <h2>Welcome to rifftales!</h2>
      <p>Create an account to start your guitar collection journey</p>

      <% if (typeof errors !=='undefined' && errors.length> 0) { %>
        <div class="form-errors">
          <ul>
            <% errors.forEach(function(error) { %>
              <li>
                <%= error %>
              </li>
              <% }) %>
          </ul>
        </div>
        <% } %>

          <form action="/api/auth/register" method="POST" class="login-form">
            <div class="form-group">
              <label for="username">Username</label>
              <input type="text" id="username" name="username" placeholder="Choose a username"
                class="<% if (typeof missing !== 'undefined' && missing.includes('username')) { %>input-error<% } %>"
                value="<%= typeof username !== 'undefined' ? username : '' %>">
            </div>

            <div class="form-group">
              <label for="email">Email address</label>
              <input type="email" id="email" name="email" placeholder="your@email.com"
                class="<% if (typeof missing !== 'undefined' && missing.includes('email')) { %>input-error<% } %>"
                value="<%= typeof email !== 'undefined' ? email : '' %>">
            </div>

            <div class="form-group">
              <label for="bio">About you (optional)</label>
              <textarea id="bio" name="bio" placeholder="Tell us about your guitar interests" rows="3"
                class="<% if (typeof missing !== 'undefined' && missing.includes('bio')) { %>input-error<% } %>"><%= typeof bio !== 'undefined' ? bio : '' %></textarea>
            </div>

            <div class="form-group">
              <label for="location">Location (optional)</label>
              <input type="text" id="location" name="location" placeholder="City, Country"
                class="<% if (typeof missing !== 'undefined' && missing.includes('location')) { %>input-error<% } %>"
                value="<%= typeof location !== 'undefined' ? location : '' %>">
            </div>

            <button type="submit" class="btn btn-primary">Create Account</button>
          </form>
          <p class="register-link">
            Already have an account? <a href="/login">Login</a>
          </p>

          <form action="/api/auth/guestLogin" method="POST" class="guest-login-form">
            <p class="guest-login-description">
              <b>Want to explore the app without signing up?</b>
            </p>
            <p class="guest-login-description" style="font-size: 0.8rem; color: #9ca3af; margin-bottom: 0.75rem;">
              Note: Guest accounts are temporary and cleared periodically. Any data will be lost.
            </p>
            <button type="submit" class="guest-login-button">
              Continue as a Temporary Guest
            </button>
          </form>

          <p style="font-size: 0.75rem; color: white; margin-top: 0.75rem; text-align: center;">
            By continuing, you acknowledge and accept the use of essential functional cookies.
          </p>
    </div>
  </div>

  <%- include('partials/footer') %>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var form = document.querySelector(".login-form");
        var button = form.querySelector("button[type='submit']");
        form.addEventListener("submit", function () {
          button.disabled = true;
        });
      });

      ParallaxBackground.init({
        zIndex: -1,
        imagePath: 'images/',
        imageCount: 24,
        speeds: [50, 70, 42, 20],
        animate: false
      });
    </script>
</body>

</html>