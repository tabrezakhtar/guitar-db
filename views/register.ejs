<!DOCTYPE html>
<html>
<head>
  <title>Sign Up - Guitar DB</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="login-container">
    <h1>Welcome to Guitar DB!</h1>
    <p>Create an account to start your guitar collection journey</p>
    
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="form-errors">
        <ul>
          <% errors.forEach(function(error) { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    
    <form action="/api/auth/register" method="POST" class="login-form">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Choose a username" class="<% if (typeof missing !== 'undefined' && missing.includes('username')) { %>input-error<% } %>" value="<%= typeof username !== 'undefined' ? username : '' %>">
      </div>
      
      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="your@email.com" class="<% if (typeof missing !== 'undefined' && missing.includes('email')) { %>input-error<% } %>" value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>
      
      <div class="form-group">
        <label for="bio">About you (optional)</label>
        <textarea id="bio" name="bio" placeholder="Tell us about your guitar interests" rows="3" class="<% if (typeof missing !== 'undefined' && missing.includes('bio')) { %>input-error<% } %>"><%= typeof bio !== 'undefined' ? bio : '' %></textarea>
      </div>
      
      <div class="form-group">
        <label for="location">Location (optional)</label>
        <input type="text" id="location" name="location" placeholder="City, Country" class="<% if (typeof missing !== 'undefined' && missing.includes('location')) { %>input-error<% } %>" value="<%= typeof location !== 'undefined' ? location : '' %>">
      </div>
      
      <button type="submit" class="btn btn-primary">Create Account</button>
    </form>
    
    <p class="register-link">
      Already have an account? <a href="/login">Login</a>
    </p>
  </div>
</body>
</html>