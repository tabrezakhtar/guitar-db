<!DOCTYPE html>
<html>

<head>
  <title>Account Verified - rifftales</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dx8d5hlk1/image/upload/v1757542335/favicon-120x120_jprwqx.png" />
  <link rel="preconnect" href="https://res.cloudinary.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="<%- !process.env.BACKEND_URL.includes('localhost') ? process.env.BACKEND_URL : '' %>/js/parallax-bg.js"></script>
  <link rel="stylesheet" href="<%- !process.env.BACKEND_URL.includes('localhost') ? process.env.BACKEND_URL : '' %>/css/styles.css">
  <style>
    * {
      box-sizing: border-box;
    }
    
    body {
      font-family: "Roboto Slab", serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #122634;
      color: #d1d5db;
      display: flex;
      flex-direction: column;
    }
    
    .main-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 6vh;
    }
    
    .verify-container {
      background: #122634;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 450px;
      margin: 1rem;
      text-align: center;
    }

    .verify-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      display: block;
    }

    .verify-icon.error {
      color: #dc2626;
    }

    h1 {
      color: #ffffff;
      font-size: 1.5rem;
      font-weight: 600;
      margin: 0 0 1.5rem 0;
    }

    .form-errors {
      background: rgba(220, 38, 38, 0.3);
      border: 1px solid #dc2626;
      border-radius: 6px;
      padding: 0.75rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .form-errors ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .form-errors li {
      color: #fca5a5;
      font-size: 0.875rem;
    }

    .verify-actions {
      margin-top: 1.5rem;
    }

    .verify-actions a {
      display: inline-block;
      background: #2563eb;
      color: #ffffff;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      transition: background-color 0.2s ease;
    }

    .verify-actions a:hover {
      background: #1d4ed8;
    }
  </style>
</head>

<body>
  <div class="main-content">
    <div class="verify-container">
      <% if (typeof errors !=='undefined' && errors.length> 0) { %>
        <!-- Show error page if there are errors -->
        <div class="verify-icon error">✕</div>
        <h1>Verification Failed</h1>

        <div class="form-errors">
          <ul>
            <% errors.forEach(function(error) { %>
              <li>
                <%= error %>
              </li>
              <% }) %>
          </ul>
        </div>

        <div class="verify-actions">
          <a href="/register" class="btn btn-primary">Back to Registration</a>
        </div>
        <% } %>

        <input type="hidden" id="token" value="<%= token %>">
        <input type="hidden" id="user" value="<%= JSON.stringify(user) %>">

        <% if (typeof errors==='undefined' || errors.length===0) { %>
          <script>
              document.addEventListener("DOMContentLoaded", function () {
              const token = document.getElementById("token").value;
              const user = document.getElementById("user").value;

              const frontendUrl = "<%- process.env.FRONTEND_URL ? process.env.FRONTEND_URL : 'http://localhost:5173' %>";
              window.location.href = `${frontendUrl}/auth?token=${encodeURIComponent(token)}&user=${encodeURIComponent(user)}`;
            });
          </script>
        <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    ParallaxBackground.init({
      zIndex: -1,
      imagePath: 'images/',
      imageCount: 24,
      speeds: [50, 70, 42, 20]
    });
  </script>
</body>

</html>