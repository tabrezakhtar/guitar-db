<!DOCTYPE html>
<html>
<head>
  <title>Login - Guitar DB</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="login-container">
    <h1>Login to Guitar DB</h1>
    <p>Enter your email address to receive a magic link for login</p>
    <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
      <div class="form-errors">
        <ul>
          <% errors.forEach(function(error) { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
    <form action="/api/auth/sendMagicLink" method="POST" class="login-form">
      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" placeholder="your@email.com" class="<% if (typeof missing !== 'undefined' && missing.includes('email')) { %>input-error<% } %>" value="<%= typeof email !== 'undefined' ? email : '' %>">
      </div>
      <button type="submit" class="btn btn-primary">Send Magic Link</button>
    </form>
    <p class="register-link">
      Don't have an account? <a href="/register">Register</a>
    </p>
  </div>
</body>
</html>
