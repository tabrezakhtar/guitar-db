<!DOCTYPE html>
<html>
<head>
  <title>Success - Guitar DB</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="success-container">
    <h1>Registration Successful!</h1>
    <div class="success-message">
      <p>🎸 Thanks for joining Guitar DB!</p>
      <% if (typeof email !== 'undefined') { %>
        <p>We've sent a magic link to <strong><%= email %></strong></p>
      <% } else { %>
        <p>We've sent a magic link to your email.</p>
      <% } %>
      <p>Click the link in your email to log in and start your guitar journey.</p>
      <p class="note">📧 If you don't see the email within a few minutes, please check your spam or junk folder.</p>
    </div>
    <div class="return-link">
      <a href="/register">Return to login page</a>
    </div>
  </div>
</body>
</html>
