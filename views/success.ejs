<!DOCTYPE html>
<html>

<head>  <title>Success - riffbook</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dx8d5hlk1/image/upload/v1757542335/favicon-120x120_jprwqx.png" />
  <link rel="preconnect" href="https://res.cloudinary.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="/js/parallax-bg.js"></script>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    * {
      box-sizing: border-box;
    }
    
    body {
      font-family: "Roboto Slab", serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #ffffff;
      color: #374151;
      display: flex;
      flex-direction: column;
    }
    
    .main-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 6vh;
    }

    @media (prefers-color-scheme: dark) {
      body {
        background: #122634;
        color: #d1d5db;
      }
    }    .success-container {
      
      background: #122634;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 500px;
      margin: 1rem;
      text-align: center;
    }

    @media (prefers-color-scheme: dark) {
      .success-container {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      }
    }

    h1 {
      
      color: #000000;
      font-size: 1.75rem;
      font-weight: 600;
      margin: 0 0 1.5rem 0;
    }

    @media (prefers-color-scheme: dark) {
      h1 {
        color: #ffffff;
      }
    }

    .success-message {
      background: #e5e7eb;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    @media (prefers-color-scheme: dark) {
      .success-message {
        background: #334155;
        border-color: #475569;
      }
    }

    .success-message p {
      
      color: #2563eb;
      margin: 0 0 1rem 0;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .success-message p:last-child {
      margin-bottom: 0;
    }

    @media (prefers-color-scheme: dark) {
      .success-message p {
        color: #60a5fa;
      }
    }

    .success-message p:first-child {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .success-message strong {
      font-weight: 600;
      color: #2563eb;
    }

    @media (prefers-color-scheme: dark) {
      .success-message strong {
        color: #60a5fa;
      }
    }

    .attempt-info {
      font-size: 0.875rem !important;
      color: #f59e0b !important;
      font-weight: 600 !important;
      margin: 0.5rem 0 !important;
      padding: 0.5rem;
      background: rgba(245, 158, 11, 0.1);
      border-radius: 4px;
      border-left: 3px solid #f59e0b;
    }

    @media (prefers-color-scheme: dark) {
      .attempt-info {
        color: #fbbf24 !important;
        background: rgba(251, 191, 36, 0.1);
        border-left-color: #fbbf24;
      }
    }

    .return-link {
      margin-top: 1.5rem;
    }

    .return-link a {
      display: inline-block;
      background: #3b82f6;
      color: #ffffff;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      transition: background-color 0.2s ease;
    }

    .return-link a:hover {
      background: #2563eb;
    }

    @media (prefers-color-scheme: dark) {
      .return-link a {
        background: #2563eb;
      }

      .return-link a:hover {
        background: #1d4ed8;
      }
    }

    .form-errors {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 6px;
      padding: 0.75rem;
      margin-bottom: 1rem;
      text-align: left;
    }

    @media (prefers-color-scheme: dark) {
      .form-errors {
        background: rgba(220, 38, 38, 0.3);
        border-color: #dc2626;
      }
    }

    .form-errors ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .form-errors li {
      color: #b91c1c;
      font-size: 0.875rem;
    }

    @media (prefers-color-scheme: dark) {
      .form-errors li {
        color: #fca5a5;
      }
    }

    .verification-form {
      margin: 2rem 0;
    }

    .form-group {
      margin-bottom: 1.5rem;
      text-align: left;
    }

    label {
      display: block;
      color: #374151;
      font-size: 0.875rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    @media (prefers-color-scheme: dark) {
      label {
        color: #d1d5db;
      }
    }    .code-input {
      width: 100%;
      padding: 1rem 1.5rem;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      background: #ffffff;
      color: #000000;
      font-size: 1.5rem;
      font-weight: 600;
      text-align: center;
      letter-spacing: 0.5rem;
      transition: all 0.2s ease;
    }

    .code-input::placeholder {
      color: #9ca3af;
      letter-spacing: 0.5rem;
    }

    .code-input:focus {
      outline: none;
      border-color: #3b82f6;
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }    @media (prefers-color-scheme: dark) {
      .code-input {
        background: #ffffff;
        border-color: #4b5563;
        color: #000000;
      }

      .code-input::placeholder {
        color: #9ca3af;
      }

      .code-input:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 3px rgba(96, 165, 250, 0.1);
      }
    }

    .input-error {
      border-color: #dc2626 !important;
      box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1) !important;
    }

    .input-hint {
      font-size: 0.75rem !important;
      color: #6b7280 !important;
      margin-top: 0.5rem !important;
      margin-bottom: 0 !important;
      text-align: center;
      font-style: italic;
    }

    @media (prefers-color-scheme: dark) {
      .input-hint {
        color: #9ca3af !important;
      }
    }

    .btn {
      width: 100%;
      background: #3b82f6;
      color: #ffffff;
      border: none;
      padding: 0.75rem 1rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn:hover:not(:disabled) {
      background: #2563eb;
      transform: translateY(-1px);
    }

    .btn:disabled {
      background: #9ca3af;
      cursor: not-allowed;
      transform: none;
    }

    .btn:active {
      transform: translateY(0);
    }

    @media (prefers-color-scheme: dark) {
      .btn {
        background: #2563eb;
      }

      .btn:hover:not(:disabled) {
        background: #1d4ed8;
      }

      .btn:disabled {
        background: #4b5563;
      }
    }

    .resend-section {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid #e5e7eb;
    }

    @media (prefers-color-scheme: dark) {
      .resend-section {
        border-top-color: #4b5563;
      }
    }

    .resend-section p {
      font-size: 0.875rem;
      color: #6b7280;
      margin-bottom: 0.5rem;
    }

    @media (prefers-color-scheme: dark) {
      .resend-section p {
        color: #9ca3af;
      }
    }

    .btn-link {
      background: none;
      border: none;
      color: #3b82f6;
      text-decoration: underline;
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0;
    }

    .btn-link:hover {
      color: #2563eb;
    }

    @media (prefers-color-scheme: dark) {
      .btn-link {
        color: #60a5fa;
      }

      .btn-link:hover {
        color: #93c5fd;
      }
    }
  </style>
</head>

<body>
  <div class="main-content">
    <div class="success-container">
      <h1 <% if (typeof titleColor !== 'undefined' && titleColor === 'white') { %>style="color: white !important;"<% } %>><% if (typeof showVerificationForm !== 'undefined' && showVerificationForm) { %>Enter Verification Code<% } else { %>Registration Successful!<% } %></h1>
    
    <% if (typeof showVerificationForm !== 'undefined' && showVerificationForm) { %>
      <div class="success-message">
        <p>Check your email for the 4-digit code</p>
        <% if (typeof attemptCount !== 'undefined' && attemptCount > 0) { %>
          <p class="attempt-info">Attempt <%= attemptCount %> of <%= typeof maxAttempts !== 'undefined' ? maxAttempts : 5 %></p>
        <% } %>
        <p>The code will expire in 15 minutes. Check your spam folder if you don't see it.</p>
      </div>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="form-errors">
          <ul>
            <% errors.forEach(function(error) { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <form action="/api/auth/verifyCode" method="POST" class="verification-form">
        <input type="hidden" name="userId" value="<%= typeof userId !== 'undefined' ? userId : '' %>">
        <div class="form-group">
          <label for="code">Enter 4-digit code</label>
          <input type="text" id="code" name="code" placeholder="1234" maxlength="4" pattern="[0-9]{4}" class="code-input <% if (typeof missing !== 'undefined' && missing.includes('code')) { %>input-error<% } %>" autocomplete="one-time-code" inputmode="numeric">
          <p class="input-hint">Enter all 4 digits, then click verify or press Enter</p>
        </div>
        <button type="submit" class="btn btn-primary">Verify Code</button>
      </form>

      <div class="resend-section">
        <p>Didn't receive the code?</p>
        <form action="/api/auth/sendCode" method="POST" style="display: inline;">
          <input type="hidden" name="userId" value="<%= typeof userId !== 'undefined' ? userId : '' %>">
          <button type="submit" class="btn-link">Send new code</button>
        </form>
      </div>
    <% } else if (typeof showResendOnly !== 'undefined' && showResendOnly) { %>
      <div class="success-message">
        <p>🔄 Request a new verification code</p>
      </div>

      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="form-errors">
          <ul>
            <% errors.forEach(function(error) { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <div class="resend-section">
        <form action="/api/auth/sendCode" method="POST">
          <input type="hidden" name="userId" value="<%= typeof userId !== 'undefined' ? userId : '' %>">
          <button type="submit" class="btn btn-primary">Get New Code</button>
        </form>
      </div>
    <% } else { %>
      <div class="success-message">
        <p>🎸 Thanks for joining riffbook!</p>
        <% if (typeof email !== 'undefined') { %>
          <p>We've sent a magic link to <strong><%= email %></strong></p>
        <% } else { %>
          <p>We've sent a magic link to your email.</p>
        <% } %>
        <p>Click the link in your email to log in and start your guitar journey.</p>
        <p class="note">📧 If you don't see the email within a few minutes, please check your spam or junk folder.</p>
      </div>
    <% } %>    <div class="return-link">
      <a href="/login">Return to login page</a>
    </div>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    document.addEventListener("DOMContentLoaded", function() {
      var forms = document.querySelectorAll("form");
      forms.forEach(function(form) {
        var button = form.querySelector("button[type='submit']");
        if (button) {
          form.addEventListener("submit", function() {
            button.disabled = true;
          });
        }
      });

      // Auto-format verification code input
      var codeInput = document.getElementById("code");
      if (codeInput) {
        // Clear the input if there are errors (failed attempt)
        var hasErrors = document.querySelector(".form-errors");
        if (hasErrors) {
          codeInput.value = "";
        }
        
        codeInput.addEventListener("input", function(e) {
          // Remove any non-numeric characters
          var value = e.target.value.replace(/[^0-9]/g, '');
          
          // Limit to 4 digits
          if (value.length > 4) {
            value = value.substring(0, 4);
          }
          
          e.target.value = value;
          
          // Visual feedback when 4 digits are entered (but don't auto-submit)
          if (value.length === 4) {
            var submitButton = e.target.closest("form").querySelector("button[type='submit']");
            if (submitButton) {
              submitButton.textContent = "Verify Code ✓";
              submitButton.style.backgroundColor = "#10b981";
              submitButton.style.transform = "scale(1.02)";
              setTimeout(function() {
                submitButton.style.backgroundColor = "";
                submitButton.style.transform = "";
              }, 200);
            }
          } else {
            var submitButton = e.target.closest("form").querySelector("button[type='submit']");
            if (submitButton) {
              submitButton.textContent = "Verify Code";
            }
          }
        });

        // Focus the code input if it exists
        codeInput.focus();
        
        // Select all text when focused
        codeInput.addEventListener("focus", function(e) {
          e.target.select();
        });
        
        // Add keyboard support for Enter key
        codeInput.addEventListener("keydown", function(e) {
          if (e.key === "Enter" && e.target.value.length === 4) {
            e.preventDefault();
            var form = e.target.closest("form");
            if (form) {
              form.submit();
            }
          }
        });
        
        // Add visual feedback for invalid attempts
        if (hasErrors) {
          codeInput.classList.add("input-error");
          
          // Remove error class when user starts typing
          codeInput.addEventListener("input", function() {
            codeInput.classList.remove("input-error");
          });
        }
      }
    });

    ParallaxBackground.init({
      zIndex: -1,
      imagePath: 'images/',
      imageCount: 24,
      speeds: [50, 70, 42, 20],
      animate: false
    });
  </script>
</body>

</html>