<!DOCTYPE html>
<html>

<head>
  <title>Account Verified - rifftales</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">  <link rel="icon" type="image/png" href="https://res.cloudinary.com/dx8d5hlk1/image/upload/v1757542335/favicon-120x120_jprwqx.png" />
  <link rel="preconnect" href="https://res.cloudinary.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="<%- !process.env.BACKEND_URL.includes('localhost') ? process.env.BACKEND_URL : '' %>/js/parallax-bg.js"></script>
  <link rel="stylesheet" href="<%- !process.env.BACKEND_URL.includes('localhost') ? process.env.BACKEND_URL : '' %>/css/styles.css">
  <style>
    * {
      box-sizing: border-box;
    }
    
    body {
      font-family: "Roboto Slab", serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: #122634;
      color: #d1d5db;
      display: flex;
      flex-direction: column;
    }
    
    .main-content {
      flex: 1;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: 6vh;
    }

    @media (max-width: 768px) {
      .main-content {
        padding-top: 0;
      }
    }
    
    .verify-container {
      background: #122634;
      padding: 2rem;
      border-radius: 8px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
      width: 100%;
      max-width: 450px;
      margin: 1rem;
      text-align: center;
    }

    .verify-icon {
      font-size: 4rem;
      margin-bottom: 1rem;
      display: block;
      animation: pulse 2s ease-in-out infinite;
    }

    .verify-icon.success {
      color: #10b981;
    }

    .verify-icon.error {
      color: #dc2626;
      animation: none;
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0.5;
      }
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    h1 {
      color: #ffffff;
      font-size: 1.75rem;
      font-weight: 600;
      margin: 0 0 1rem 0;
      line-height: 1.3;
    }

    .verify-message {
      color: #9ca3af;
      font-size: 1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    .spinner {
      display: inline-block;
      width: 40px;
      height: 40px;
      border: 4px solid rgba(255, 255, 255, 0.1);
      border-top-color: #10b981;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 1rem auto;
    }

    .form-errors {
      background: rgba(220, 38, 38, 0.2);
      border: 1px solid rgba(220, 38, 38, 0.5);
      border-radius: 6px;
      padding: 1rem;
      margin-bottom: 1.5rem;
      text-align: left;
    }

    .form-errors ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .form-errors li {
      color: #fecaca;
      font-size: 0.95rem;
      line-height: 1.5;
      padding: 0.25rem 0;
    }

    .verify-actions {
      margin-top: 1.5rem;
    }

    .verify-actions a {
      display: inline-block;
      background: #2563eb;
      color: #ffffff;
      text-decoration: none;
      padding: 0.75rem 1.5rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      transition: background-color 0.2s ease;
    }

    .verify-actions a:hover {
      background: #1d4ed8;
    }
  </style>
</head>

<body>
  <div class="main-content">
    <div class="verify-container">
      <% if (typeof errors !=='undefined' && errors.length> 0) { %>
        <div class="verify-icon error">✕</div>
        <h1>Verification Failed</h1>

        <div class="form-errors">
          <ul>
            <% errors.forEach(function(error) { %>
              <li>
                <%= error %>
              </li>
              <% }) %>
          </ul>
        </div>

        <div class="verify-actions">
          <a href="/register">Back to Registration</a>
        </div>
        <% } %>

        <input type="hidden" id="user" value="<%= JSON.stringify(user) %>">

        <% if (typeof errors==='undefined' || errors.length===0) { %>
          <div class="verify-icon success">✓</div>
          <h1>Account Verified Successfully</h1>
          <p class="verify-message">Your account has been verified. You will be redirected to the app in a moment.</p>
          <div class="spinner"></div>

          <script>
              document.addEventListener("DOMContentLoaded", function () {
              const user = document.getElementById("user").value;

              const frontendUrl = "<%- process.env.FRONTEND_URL ? process.env.FRONTEND_URL : 'http://localhost:5173' %>";
              
              setTimeout(() => {
                window.location.href = `${frontendUrl}/auth?user=${encodeURIComponent(user)}`;
              }, 1500);
            });
          </script>
        <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
    ParallaxBackground.init({
      zIndex: -1,
      imagePath: 'images/',
      imageCount: 24,
      speeds: [50, 70, 42, 20]
    });
  </script>
</body>

</html>